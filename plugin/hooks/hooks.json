{
    "description": "Hands the agent what the user did on the outline's page with each prompt, and the outline's map after compaction or resume.",
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/outline-hook.js\"", "timeout": 5 }]
            }
        ],
        "SessionStart": [
            {
                "matcher": "resume|compact",
                "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/outline-hook.js\"", "timeout": 5 }]
            }
        ]
    }
}
